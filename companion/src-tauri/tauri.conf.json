{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Eudonomia",
  "version": "0.1.2",
  "identifier": "ai.eudonomia.companion",
  "build": {
    "frontendDist": "../webui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Eudonomia",
        "width": 1040,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/clemenssteinbrennercrypto-prog/eudonomia/releases/download/internal-test/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGOEIyMDhEQUQzQkFDQTIKUldTaXJEdXRqU0NML3lXZXlpTkhPcUpnSEFPQmZSWGx1cGpwRTl1WVJ3SzNLM0JMaktUYmsvOUQK"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
