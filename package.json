{
  "name": "eudaimonai",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "refresh:companion-webui": "node scripts/refresh-companion-webui.mjs",
    "verify:companion-webui": "node scripts/refresh-companion-webui.mjs --verify",
    "build:companion": "npm run refresh:companion-webui && cd companion/src-tauri && cargo tauri build",
    "preview": "vite preview",
    "mediapipe:copy": "node scripts/copy-mediapipe.mjs",
    "camera:parity:compare": "node scripts/camera-parity/compare.mjs",
    "predev": "node scripts/copy-mediapipe.mjs",
    "prebuild": "node scripts/copy-mediapipe.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src scripts vite.config.js"
  },
  "dependencies": {
    "@mediapipe/face_mesh": "^0.4.1633559619",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
